# Copia este archivo a .env y ajusta los valores. .env nunca se versiona.

# --- Base de datos (contenedor db) ---
POSTGRES_USER=agenda
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=agenda
# Puerto del host hacia Postgres (5433 porque el 5432 suele ocupar un Postgres local)
DB_PUERTO_HOST=5433

# --- API (contenedor api) ---
# En Compose se arma sola desde las variables de arriba; aquí solo para correr sin Docker.
# DATABASE_URL=postgresql://agenda:cambia-esta-contrasena@localhost:5433/agenda
ALMACENAMIENTO=postgres
APLICAR_MIGRACIONES=true
API_PORT=8001

# --- Interfaz (contenedor ui) ---
# Dirección de la API vista desde la interfaz (en Compose apunta al servicio api).
API_URL=http://localhost:8001
FRONTEND_PORT=8085
HTTP_TIMEOUT_S=5
